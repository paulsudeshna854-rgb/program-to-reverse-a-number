public class NumberPalindrome {
    public static boolean isPalindrome(int number) {
        // Negative numbers are not palindromes (e.g., -121 reversed is 121-)
        if (number < 0) {
            return false;
        }

        int originalNumber = number;
        int reversedNumber = 0;

        while (number != 0) {
            int lastDigit = number % 10;
            reversedNumber = (reversedNumber * 10) + lastDigit;
            number /= 10; // Remove the last digit
        }

        // If the reversed number matches the original, it's a palindrome
        return originalNumber == reversedNumber;
    }

    public static void main(String[] args) {
        int testNum = 12321;
        
        if (isPalindrome(testNum)) {
            System.out.println(testNum + " is a palindrome.");
        } else {
            System.out.println(testNum + " is not a palindrome.");
        }
    }
}
